# Supabase (obrigatório)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_SUA_SERVICE_ROLE_KEY

# Fila no Supabase
QUEUE_TABLE=customer_erp_queue
QUEUE_BATCH_SIZE=20
POLL_INTERVAL_SECONDS=15

# ERP / SQL Server (Support Informática)
# Exemplo para SQL Server Driver 17
ERP_ODBC_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};SERVER=192.168.15.147,1433;DATABASE=BoxMatriz;UID=seu_usuario;PWD=sua_senha;TrustServerCertificate=yes;

# SQL de inserção no ERP (ajuste conforme sua tabela real de clientes)
# Precisa usar placeholders '?' e mesma ordem em ERP_PARAM_ORDER
ERP_INSERT_SQL=INSERT INTO CLIENTES (NOME, EMAIL, TELEFONE, CPF_CNPJ, ENDERECO) VALUES (?,?,?,?,?)

# Ordem dos dados enviados para os placeholders da query acima
ERP_PARAM_ORDER=full_name,email,phone,document,address

# Teste sem gravar no ERP (true/false)
DRY_RUN=true

# Retry em falhas temporárias do ERP
ERP_WRITE_MAX_RETRIES=3
ERP_WRITE_RETRY_DELAY_SECONDS=2
ERP_WRITE_RETRY_BACKOFF_MULTIPLIER=2

# Sincronizar número de pré-venda com o ERP (recomendado)
ORDER_SEQUENCE_SYNC_ENABLED=true
# Query que retorna o último número usado no ERP (uma linha, uma coluna numérica)
ERP_LAST_PREORDER_SQL=SELECT ISNULL(MAX(NUMERO_PEDIDO),0) FROM PEDIDOS

# Logs
LOG_LEVEL=INFO
